{
  "name": "setup-marimohub-cli",
  "version": "1.0.1",
  "private": true,
  "description": "Set up the marimohub CLI in GitHub Actions workflows",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "oxlint src test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run format && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/tool-cache": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vercel/ncc": "0.45.0",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
